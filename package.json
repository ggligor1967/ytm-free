{
  "name": "ytm-free",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "scripts": {
    "cleanup": "node scripts/cleanup-ports.mjs",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "dev": "node scripts/cleanup-ports.mjs && vite",
    "build": "tsc && vite build",
    "build:wdio": "tsc && vite build --mode wdio",
    "typecheck:wdio": "tsc --noEmit -p tsconfig.wdio.json",
    "harness:build": "tauri build --debug --no-bundle --features wdio --config src-tauri/tauri.wdio.conf.json",
    "harness:schema": "wdio run wdio.conf.ts --spec tests/e2e/schema-bootstrap.spec.ts",
    "harness:semantic": "wdio run wdio.conf.ts --spec tests/e2e/semantic-progress.spec.ts",
    "harness:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-semantic-harness.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mocha": "10.0.10",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@wdio/cli": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "^29.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "4.23.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "webdriverio": "9.27.1"
  }
}
